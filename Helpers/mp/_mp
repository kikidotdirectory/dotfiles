#compdef mp

_mp() {
  local templates_dir="$DOTFILES/Helpers/mp/templates"
  local -a templates
  templates=("${(@f)$(ls "$templates_dir" 2>/dev/null)}")

  if (( ${words[(I)-e]} )); then
    _describe 'template' templates
    return
  fi

  case $CURRENT in
    2)
      _describe 'template' templates
      ;;
    3)
      _directories
      ;;
  esac
}

_mp "$@"
