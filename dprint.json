{
  "json": {
  },
  "markdown": {
  },
  "toml": {
  },
  "markup": {
  },
  "exec": {
    "cwd": "${configDir}",
    "commands": [
      {
        "command": "shfmt",
        "exts": ["sh", "bash"]
      }
    ]
  },
  "excludes": [
    "**/*-lock.json"
  ],
  "plugins": [
    "npm:@dprint/json@0.23.0",
    "npm:@dprint/markdown@0.24.0",
    "npm:@dprint/toml@0.8.0",
    "npm:dprint-plugin-markup@0.27.3",
    "npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67"
  ]
}
